{
  "manifest_version": 3,
  "name": "Boxel 3D Modded",
  "description": "Boxel 3D is a speedrunning game packed with challenging levels, custom skins, online multiplayer, and a creative level editor.",
  "version": "1.1.0",
  "action": {
    "default_popup": "index.html",
    "default_title": "Boxel 3D Modded",
    "default_icon": {
      "16": "png/icon16.png",
      "48": "png/icon48.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval';"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{243e7bef-af81-4706-8f76-e3f9942aeab3}",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ]
}